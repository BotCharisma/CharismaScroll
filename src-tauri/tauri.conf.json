{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CharismaScroll",
  "version": "1.0.0",
  "identifier": "com.charismascroll.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CharismaScroll",
        "width": 1020,
        "height": 680,
        "minWidth": 880,
        "minHeight": 580,
        "center": true,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
